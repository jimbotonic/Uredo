##! 20 — Pattern matching, the full toolbox: nested patterns, `@` bindings, ranges,
##! slice patterns, `ref`/`ref mut`, or-patterns, and matching on tuples and references.
##! Every pattern here is Rust's (§13.1); Uredo only changes the arm punctuation.

@derive(Debug)
enum Token:
    Num(i64)
    Ident(String)
    Punct(char)

## Slice patterns classify a token stream by shape.
fn shape(tokens: [Token]) -> String:
    match tokens:
        []: String::from("empty")
        [Token::Num(n)]: format("just {n}")
        [Token::Ident(name), Token::Punct('='), rest @ ..]: format("assign {name} <- {} tokens", rest.len())
        [first, .., last]: format("{first:?} … {last:?}")
        [single]: format("single {single:?}")

## `@` binds the whole while testing a sub-pattern; ranges and or-patterns on chars.
fn classify(c: char) -> &'static str:
    match c:
        'a'..='z' | 'A'..='Z': "letter"
        d @ '0'..='9' if d != '0': "nonzero digit"
        '0': "zero"
        _: "other"

## Matching a reference: `&(a, b)` destructures through the borrow; `ref` avoids moving.
fn sum_pairs(pairs: [(i32, i32)]) -> i32:
    var total = 0
    for &(a, b) in pairs: total += a * b
    total

@derive(Debug)
struct Config:
    name: String
    retries: u32
    verbose: bool

fn tune(cfg: inout Config):
    # `ref mut` borrows a field mutably inside a pattern; `..` ignores the rest.
    match *cfg:
        Config { ref mut retries, verbose: true, .. }: *retries += 1
        Config { ref name, .. }: print("quiet config {name}")

fn main():
    toks = Vec::from([Token::Ident(String::from("x")), Token::Punct('='), Token::Num(4), Token::Num(2)])
    print(shape(toks))
    print(shape(&toks[2..]))                        # an explicit slice expression, verbatim Rust
    print(shape(&toks[..0]))
    for c in ['q', '7', '0', '!']:
        print("{c}: {}", classify(c))
    print("{}", sum_pairs([(1, 2), (3, 4)]))
    var cfg = Config { name: String::from("dev"), retries: 1, verbose: true }
    tune(cfg)
    cfg.verbose = false
    tune(cfg)
    print("{cfg:?}")

    # Nested `Option<Result<…>>` and a tuple scrutinee: patterns compose.
    inputs: Vec<(u8, Result<u8, String>?)> = Vec::from([(1, None), (2, Some(Ok(9))), (3, Some(Err(String::from("x"))))])
    for pair in inputs:
        match pair:
            (id, None): print("{id}: nothing")
            (id, Some(Ok(v))) if *v > 5: print("{id}: big {v}")
            (id, Some(Ok(v))): print("{id}: {v}")
            (id, Some(Err(e))): print("{id}: error {e}")
