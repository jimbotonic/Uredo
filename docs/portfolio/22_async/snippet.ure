##! 22 — Async: `async fn`, postfix `.await`, `.await?`, spawning tasks, channels.
##! Uredo ships no runtime: Tokio is an ordinary dependency, entered through a forwarded
##! attribute (§21). Async surface syntax is Phase 2 in the plan; the rules are the same as sync.

use std::time::Duration
use tokio::sync::mpsc
use tokio::time::sleep

@derive(Debug)
struct Weather:
    city: String
    temp_c: f64

## An `async fn` returning `throws`: the body awaits with postfix `.await`; `?` composes (D30).
async fn fetch_weather(city: str) -> Weather throws String:
    sleep(Duration::from_millis(10)).await                  # a simulated I/O wait
    if city.is_empty(): throw String::from("no city")
    Weather { city: city.to_string(), temp_c: 21.5 }

## Awaiting several futures concurrently: `tokio::join!` is a macro, invoked directly (D23).
async fn both() -> (Weather, Weather) throws String:
    (a, b) = tokio::join!(fetch_weather("Oslo"), fetch_weather("Lima"))
    (a?, b?)

## `@rust(tokio::main)` forwards the runtime attribute unchanged (§21).
@rust(tokio::main)
async fn main() throws String:
    w = fetch_weather("Bern").await?
    print("{w:?} ({} °C)", w.temp_c)
    print("{:?}", fetch_weather("").await)
    (a, b) = both().await?
    print("{} {}", a.city, b.city)

    # Spawned tasks are `'static`: the closure/future owns its data (`move`), as in Rust.
    (tx, rx) = mpsc::channel::<u32>(8)
    var rx = rx                                          # `recv` needs `&mut`, so rebind mutably
    for i in 0..3u32:
        let tx = tx.clone()
        tokio::spawn(async move { tx.send(i * i).await.unwrap() })    # an async block is Rust source (a `rust`-style block expression)
    drop(tx)
    var got = Vec::new()
    while let Some(v) = rx.recv().await:
        got.push(v)
    got.sort()
    print("{got:?}")
