##! Per-function comparison of two LLVM IR files (raw or normalized).
##!
##! For each `define`: instruction count (labels and comments excluded), opcode sequence, alloca
##! byte sizes. status: `same_opcodes` | `same_counts_diff_opcodes` | `DIFF` | `ONLY-ONE-SIDE`.
##! Exits 1 if any function is not `same_opcodes`, or if no function was found at all.

use std::collections::{BTreeMap, BTreeSet}
use std::fs
use regex::Regex

## What one `define` contributes: its opcodes in order, and the byte size of each `alloca`.
@derive(Default, Clone)
struct Body:
    ops: Vec<String>
    allocs: Vec<i64>

impl Body:
    fn alloca_bytes(self) -> i64:
        allocs.iter().sum()

## Two crates of the same source differ only in the hashes their symbols carry; normalise those
## away so that the two modules can be compared function by function.
fn crate_norm(name: str) -> String:
    var out = name.to_string()
    for (pattern, replacement) in [
        (r"17h[0-9a-f]{16}E", "17hHE"),
        (r"Cs[A-Za-z0-9]+_[0-9]+(piece|p[0-9]_(orig|gen))", "CsX_piece"),
        (r"B[0-9a-zA-Z]+_", "B_"),
        (r"Xs[0-9a-z]*_", "Xs_"),
    ]:
        out = Regex::new(pattern).expect("the pattern").replace_all(&out, replacement).to_string()
    out

fn funcs(path: str) -> BTreeMap<String, Body>:
    define = Regex::new(r#"define .*?@("?[^("]+"?)\("#).expect("the pattern")
    label = Regex::new(r#"^[A-Za-z0-9_.$"]+:$"#).expect("the pattern")
    opcode = Regex::new(r"^(?:%[^ ]+ = )?(\w+)").expect("the pattern")
    callee = Regex::new(r#"@("?[^(" ]+"?)"#).expect("the pattern")
    size = Regex::new(r"alloca \[(\d+) x i8\]").expect("the pattern")

    var out: BTreeMap<String, Body> = BTreeMap::new()
    var name: String? = None
    var body = Body::default()
    for line in fs::read_to_string(path).expect("the IR file").lines():
        if let Some(c) = define.captures(line):
            name = Some(crate_norm(&c[1]))
            body = Body::default()
            continue
        if name.is_none():
            continue
        if line.starts_with('}'):
            key = name.clone().unwrap_or_default()
            if out.contains_key(&key):
                eprint("duplicate normalized function name {key}")
                std::process::exit(1)
            out.insert(key, body.clone())
            name = None
            continue
        s = line.split(';').next().unwrap_or("").trim()
        if s.is_empty() || label.is_match(s):
            continue
        var op = match opcode.captures(s):
            Some(c):
                c[1].to_string()
            None:
                s.split_whitespace().next().unwrap_or("").to_string()
        if op == "call" || op == "invoke" || op == "tail":
            named = match callee.captures(s):
                Some(c): crate_norm(&c[1])
                None: String::from("?")
            op = format("{op} {named}")
        if op == "alloca":
            bytes = match size.captures(s):
                Some(c): c[1].parse().unwrap_or(-1)
                None: -1
            body.allocs.push(bytes)
        body.ops.push(op)
    out

fn short(name: str) -> String:
    trimmed = Regex::new(r"^_R[A-Za-z0-9_]*?piece").expect("the pattern").replace(name, "").to_string()
    trimmed.chars().take(70).collect::<String>()

fn main():
    args: Vec<String> = std::env::args().skip(1).collect()
    if args.len() < 2:
        eprint("usage: ir-compare <a.ll> <b.ll>")
        std::process::exit(2)
    a = funcs(args[0])
    b = funcs(args[1])
    var keys: BTreeSet<String> = BTreeSet::new()
    for k in a.keys():
        keys.insert(k.clone())
    for k in b.keys():
        keys.insert(k.clone())

    var same = 0
    var diff = 0
    var only = 0
    var counts_only = 0
    for k in keys:
        match (a.get(k), b.get(k)):
            (Some(x), Some(y)):
                if x.ops == y.ops && x.allocs == y.allocs:
                    same += 1
                else if x.ops.len() == y.ops.len() && x.allocs == y.allocs:
                    counts_only += 1
                    print("{}\t{}\t{}\t{}\t{}\tsame_counts_diff_opcodes", short(k), x.ops.len(), y.ops.len(), x.alloca_bytes(), y.alloca_bytes())
                else:
                    diff += 1
                    print("{}\t{}\t{}\t{}B\t{}B\tDIFF", short(k), x.ops.len(), y.ops.len(), x.alloca_bytes(), y.alloca_bytes())
            _:
                only += 1
                left = a.get(k).map(v => v.ops.len()).unwrap_or(0)
                right = b.get(k).map(v => v.ops.len()).unwrap_or(0)
                print("{}\t{}\t{}\t\t\tONLY-ONE-SIDE", short(k), left, right)

    instr_orig: usize = a.values().map(v => v.ops.len()).sum()
    instr_gen: usize = b.values().map(v => v.ops.len()).sum()
    alloca_orig: i64 = a.values().map(v => v.alloca_bytes()).sum()
    alloca_gen: i64 = b.values().map(v => v.alloca_bytes()).sum()
    print("SUMMARY functions={} same_opcodes={} same_counts_diff_opcodes={} diff={} only_one_side={} instr_total_orig={} instr_total_gen={} alloca_bytes_orig={} alloca_bytes_gen={}",
        keys.len(), same, counts_only, diff, only, instr_orig, instr_gen, alloca_orig, alloca_gen)
    if !(same > 0 && diff == 0 && only == 0 && counts_only == 0):
        std::process::exit(1)
