##! Size and complexity metrics for `.rs` and `.ure` files, computed with ONE tokenizer so the
##! versions are comparable.
##!
##! usage: metrics file [file...]  -> TSV rows

use std::fs
use regex::Regex

const PUNCT: str = r"::<|::|->|=>|\.\.=|\.\.|&&|\|\||==|!=|<=|>=|\+=|-=|\*=|/=|%=|<<|>>|[-+*/%=<>!&|^~?@#$:;,.(){}\[\]]"

fn token_pattern() -> String:
    format(r#"r\#"[\s\S]*?"\#|r"[^"]*"|b?"(?:\\.|[^"\\])*"|b?'(?:\\u\{{[0-9A-Fa-f]+\}}|\\x[0-9A-Fa-f]{{2}}|\\.|[^'\\\n])'|'[A-Za-z_][A-Za-z0-9_]*|[A-Za-z_][A-Za-z0-9_]*!?|0x[0-9A-Fa-f_]+|\d[\d_]*(?:\.\d[\d_]*)?(?:[eE][+-]?\d+)?[A-Za-z0-9]*|{}"#, PUNCT)

## Everything one file contributes to the table, in the order the columns are printed.
struct Row:
    file: String
    lang: String
    lines: usize
    nonws_chars: usize
    tokens: usize
    ident_tokens: usize
    punct_tokens: usize
    cyclomatic: usize
    max_nesting: usize
    annotations: usize
    fns: usize

impl Row:
    fn columns() -> Vec<String>:
        Vec::from(["file", "lang", "lines", "nonws_chars", "tokens", "ident_tokens", "punct_tokens",
            "cyclomatic", "max_nesting", "annotations", "fns"]).iter().map(s => s.to_string()).collect()

    fn values(self) -> Vec<String>:
        Vec::from([
            file.clone(), lang.clone(), lines.to_string(), nonws_chars.to_string(),
            tokens.to_string(), ident_tokens.to_string(), punct_tokens.to_string(),
            cyclomatic.to_string(), max_nesting.to_string(), annotations.to_string(), fns.to_string(),
        ])

## `src` with comments removed and every string literal left intact.
##
## One scan over the whole text rather than one per line, because a raw string spans lines and its
## `#` and `//` are not comments. A line-at-a-time scanner cut `const X = r#"` at the `#`, and the
## body of the literal was then read as code. Newlines are preserved so the line count is unchanged.
fn strip_comments(src: str, lang: str) -> String:
    c: Vec<char> = src.chars().collect()
    n = c.len()
    var out = String::new()
    var i = 0
    while i < n:
        # a raw string: r#*" … "#* , with the hash count matched
        if c[i] == 'r':
            var j = i + 1
            while j < n && c[j] == '#':
                j += 1
            if j < n && c[j] == '"':
                hashes = j - i - 1
                var closer = String::from("\"")
                for _h in 0..hashes:
                    closer.push('#')
                rest: String = c[j + 1..].iter().collect()
                stop = match rest.find(&closer):
                    Some(at): j + 1 + rest[..at].chars().count() + closer.chars().count()
                    None: n
                for k in i..stop.min(n):
                    out.push(c[k])
                i = stop
                continue
        if c[i] == '"':
            out.push(c[i])
            i += 1
            while i < n:
                out.push(c[i])
                if c[i] == '\\' && i + 1 < n:
                    out.push(c[i + 1])
                    i += 2
                    continue
                if c[i] == '"':
                    i += 1
                    break
                i += 1
            continue
        if lang == "rs" && c[i] == '/' && i + 1 < n && c[i + 1] == '*':
            var stop = i + 2
            while stop + 1 < n && !(c[stop] == '*' && c[stop + 1] == '/'):
                stop += 1
            end = (stop + 2).min(n)
            for k in i..end:
                if c[k] == '\n':
                    out.push('\n')          # keep the line count
            i = end
            continue
        line_comment = (c[i] == '/' && i + 1 < n && c[i + 1] == '/') || (lang != "rs" && c[i] == '#')
        if line_comment:
            while i < n && c[i] != '\n':
                i += 1
            continue
        out.push(c[i])
        i += 1
    out

## Tests are excluded from every count, on both sides.
fn split_tests(src: str, lang: str) -> String:
    marker = if lang == "rs": "#[cfg(test)]" else: "@cfg(test)"
    match src.find(marker):
        Some(i): src[..i].to_string()
        None: src.to_string()

## Uredo match arms: the lines one indentation step inside a `match …:` header.
fn match_arms_ure(lines: [String]) -> usize:
    header = Regex::new(r"\bmatch\b.*:\s*$").expect("the pattern")
    var arms = 0
    var stack: Vec<usize> = Vec::new()
    for line in lines:
        if line.trim().is_empty():
            continue
        indent = line.len() - line.trim_start_matches(' ').len()
        while !stack.is_empty() && indent <= stack[stack.len() - 1]:
            stack.pop()
        if header.is_match(line):
            stack.push(indent)
            continue
        if !stack.is_empty() && indent == stack[stack.len() - 1] + 4:
            arms += 1
    arms

fn count_word(text: str, word: str) -> usize:
    Regex::new(&format(r"\b{word}\b")).expect("the pattern").find_iter(text).count()

## Lifetimes, removed before the char literals are, so that `'a'` is not read as one. The regex
## crate has no lookahead, so where Python wrote `(?!')` this checks the next character itself.
fn strip_lifetimes(text: str) -> String:
    pattern = Regex::new(r"'[A-Za-z_][A-Za-z0-9_]*\b").expect("the pattern")
    var out = String::new()
    var last = 0
    for m in pattern.find_iter(text):
        followed_by_quote = text[m.end()..].starts_with('\'')
        if followed_by_quote:
            continue
        out.push_str(&text[last..m.start()])
        last = m.end()
    out.push_str(&text[last..])
    out

## `code` with every string and char literal replaced by `""`.
##
## Annotations are a property of the code, not of the strings inside it: an English possessive
## counts as a lifetime and an `&` in a message as a borrow. Pairing quotes with a pattern gets
## this wrong on `r#"…"#`, whose body may hold a quote of its own, so the tokenizer — which already
## knows every literal form — is what decides where a literal starts and ends. Lifetimes are left
## alone: they are what the tick count is for.
fn blank_literals(code: str, spans: [(usize, usize, &str)]) -> String:
    literal = Regex::new(r#"^(?:r\#*"|b?"|b?'.*'$)"#).expect("the pattern")
    var out = String::new()
    var last = 0
    for (start, end, text) in spans:
        if literal.is_match(text):
            out.push_str(&code[last.. *start])
            out.push_str("\"\"")
            last = *end
    out.push_str(&code[last..])
    out

## Rust nests by brace, Uredo by indentation; each side's deepest is its own measure.
fn brace_depth(code: str) -> usize:
    var depth: i64 = 0
    var deepest: i64 = 0
    for c in code.chars():
        if c == '{':
            depth += 1
            if depth > deepest:
                deepest = depth
        else if c == '}':
            depth -= 1
    deepest as usize

fn indent_depth(lines: [&str]) -> usize:
    lines.iter().map(l => (l.len() - l.trim_start_matches(' ').len()) / 4).max().unwrap_or(0)

fn metrics(path: str) -> Row:
    lang = if path.ends_with(".ure"): "ure" else: "rs"
    raw = fs::read_to_string(path).expect("the file")
    code = strip_comments(&split_tests(raw, lang), lang)
    lines: Vec<&str> = code.split('\n').filter(l => !l.trim().is_empty()).collect()
    token = Regex::new(&token_pattern()).expect("the token pattern")
    spans: Vec<(usize, usize, &str)> = token.find_iter(&code).map(m => (m.start(), m.end(), m.as_str())).collect()
    toks: Vec<&str> = spans.iter().map(s => s.2).collect()
    ident_start = Regex::new(r"^[A-Za-z_]").expect("the pattern")
    punct_only = Regex::new(&format("^(?:{})$", PUNCT)).expect("the pattern")
    idents = toks.iter().filter(t => ident_start.is_match(t) && !t.starts_with('\'') && !t.starts_with('"') && !t.starts_with("b\"")).count()
    puncts = toks.iter().filter(t => punct_only.is_match(t)).count()
    nonws = code.chars().filter(c => !c.is_whitespace()).count()

    bare = blank_literals(&code, spans)
    ticks = Regex::new(r"'[a-z_]+\b").expect("the pattern").find_iter(&bare).count()
    ampersands = bare.matches('&').count()

    rust_side = lang == "rs"
    arms = if rust_side:
        code.matches("=>").count()
    else:
        owned: Vec<String> = code.split('\n').filter(l => !l.trim().is_empty()).map(l => l.to_string()).collect()
        match_arms_ure(owned)
    nesting = if rust_side: brace_depth(&code) else: indent_depth(lines)
    annotations = if rust_side:
        ampersands + count_word(&bare, "mut") + ticks
    else:
        ampersands + count_word(&bare, "take") + count_word(&bare, "inout") + count_word(&bare, "var") + ticks

    matches_kw = count_word(code, "match")
    # logical operators: exclude closure parameter lists `|x|` and `||` in Rust
    var logic = code.clone()
    if lang == "rs":
        logic = Regex::new(r"([(,=])\s*\|\|").expect("the pattern").replace_all(&logic, "$1").to_string()
        logic = Regex::new(r"([(,=])\s*\|[^|\n]*\|").expect("the pattern").replace_all(&logic, "$1").to_string()
    # `?` only as an operator: strip lifetimes, then string and char literals
    var ops = strip_lifetimes(code)
    ops = Regex::new(r#"r\#"[\s\S]*?"\#|r"[^"]*"|b?"(?:\\.|[^"\\])*"|b?'(?:\\u\{[0-9A-Fa-f]+\}|\\x[0-9A-Fa-f]{2}|\\.|[^'\\\n])'"#).expect("the pattern").replace_all(&ops, "").to_string()
    ands = logic.matches("&&").count()
    ors = logic.matches("||").count()
    questions = ops.matches('?').count()
    extra_arms = if arms > matches_kw: arms - matches_kw else: 0
    cyclomatic = 1 + count_word(code, "if") + count_word(code, "while") + count_word(code, "for") + ands + ors + questions + extra_arms

    Row {
        file: path.to_string(),
        lang: lang.to_string(),
        lines: lines.len(),
        nonws_chars: nonws,
        tokens: toks.len(),
        ident_tokens: idents,
        punct_tokens: puncts,
        cyclomatic,
        max_nesting: nesting,
        annotations,
        fns: count_word(code, "fn"),
    }

fn main():
    paths: Vec<String> = std::env::args().skip(1).collect()
    if paths.is_empty():
        eprint("usage: metrics file [file...]")
        std::process::exit(2)
    rows: Vec<Row> = paths.iter().map(p => metrics(p)).collect()
    print("{}", Row::columns().join("\t"))
    for r in rows:
        print("{}", r.values().join("\t"))
