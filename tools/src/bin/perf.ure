##! §36 allocation, memory and size fixtures: the generated Rust must not exceed its idiomatic twin.
##!
##! For every §43 program this exports the Uredo side with `uredo package`, copies the twin, appends
##! a counting global allocator to each and renames the program's `main` so a wrapper can report the
##! totals, builds both in release with the same settings and runs each three times. Four measures,
##! gated as §36 words them:
##!
##!   allocations   calls to the global allocator        gated: uredo <= twin
##!   bytes         total bytes it was asked for         gated: uredo <= twin
##!   peak          high-water mark of live bytes        reported (see the note in PERF.md)
##!   size          the release binary                   gated against a checked-in baseline
##!
##! Binary size is *not* compared against the twin. Measured: with the two crate names made equal
##! the gap on one program moved from 328 to 384 bytes, in the other direction, so the paired figure
##! carries the length of the crate name, the embedded build paths and section padding rather than
##! the cost of the lowering. §36 asks for a checked-in limit per fixture, and that is what gates.
##!
##! A program whose own counts move between runs is reported as unstable rather than compared, since
##! a moving baseline proves nothing. Binary size also has a **checked-in absolute baseline**
##! (`corpus/size_baseline.json`): it is toolchain-specific, so it is compared only when the recorded
##! rustc version matches the one in use, and `--update-baseline` rewrites it.
##!
##! usage: perf [--update-baseline] [NN_name …]      (default: every program)

use std::collections::BTreeMap
use std::fs
use std::path::{Path, PathBuf}
use std::process::Command
use serde::{Deserialize, Serialize}
use regex::Regex

const RUNS: usize = 3

## Appended, never prepended: a module's inner docs and inner attributes must stay first.
const COUNTER: str = r#"

// ---- §36 fixture probe: appended by corpus/perf.py, not part of the program ----
mod __alloc_probe {
    use std::alloc::{GlobalAlloc, Layout, System};
    use std::sync::atomic::{AtomicUsize, Ordering::Relaxed};

    pub static COUNT: AtomicUsize = AtomicUsize::new(0);
    pub static BYTES: AtomicUsize = AtomicUsize::new(0);
    pub static LIVE: AtomicUsize = AtomicUsize::new(0);
    pub static PEAK: AtomicUsize = AtomicUsize::new(0);

    fn grew(by: usize) {
        let live = LIVE.fetch_add(by, Relaxed) + by;
        PEAK.fetch_max(live, Relaxed);
    }

    pub struct Counting;

    unsafe impl GlobalAlloc for Counting {
        unsafe fn alloc(&self, l: Layout) -> *mut u8 {
            COUNT.fetch_add(1, Relaxed);
            BYTES.fetch_add(l.size(), Relaxed);
            grew(l.size());
            unsafe { System.alloc(l) }
        }
        unsafe fn dealloc(&self, p: *mut u8, l: Layout) {
            LIVE.fetch_sub(l.size(), Relaxed);
            unsafe { System.dealloc(p, l) }
        }
        unsafe fn realloc(&self, p: *mut u8, l: Layout, new: usize) -> *mut u8 {
            COUNT.fetch_add(1, Relaxed);
            BYTES.fetch_add(new.saturating_sub(l.size()), Relaxed);
            if new >= l.size() {
                grew(new - l.size());
            } else {
                LIVE.fetch_sub(l.size() - new, Relaxed);
            }
            unsafe { System.realloc(p, l, new) }
        }
    }
}

#[global_allocator]
static __ALLOC: __alloc_probe::Counting = __alloc_probe::Counting;

fn main() -> impl std::process::Termination {
    let __result = __prog_main();
    {
        use std::sync::atomic::Ordering::Relaxed;
        eprintln!(
            "__ALLOC_PROBE {} {} {}",
            __alloc_probe::COUNT.load(Relaxed),
            __alloc_probe::BYTES.load(Relaxed),
            __alloc_probe::PEAK.load(Relaxed)
        );
    }
    __result
}
"#

## `peak` and `size` are measured and reported; only the first two are gated against the twin (§36).
fn gated() -> Vec<&'static str>:
    Vec::from(["allocations", "bytes"])

@derive(Serialize, Deserialize, Clone)
struct Side:
    allocations: u64
    bytes: u64
    peak: u64
    size: u64
    stable: bool
    runs: Vec<(u64, u64, u64)>

@derive(Serialize)
struct Entry:
    program: String
    @serde(skip_serializing_if = "Option::is_none")
    error: String?
    @serde(skip_serializing_if = "Option::is_none")
    uredo: Side?
    @serde(skip_serializing_if = "Option::is_none")
    rust: Side?
    @serde(skip_serializing_if = "Option::is_none")
    stable: bool?
    @serde(skip_serializing_if = "Option::is_none")
    exceeds: Vec<String>?
    @serde(skip_serializing_if = "Option::is_none")
    pass: bool?
    @serde(skip_serializing_if = "Option::is_none")
    identical: bool?
    @serde(skip_serializing_if = "Option::is_none")
    baseline_size: u64?
    @serde(skip_serializing_if = "Option::is_none")
    over_baseline: bool?

@derive(Serialize)
struct Report:
    rustc: String
    programs: Vec<Entry>

@derive(Serialize, Deserialize, Default)
struct Baseline:
    note: String
    rustc: String
    size: BTreeMap<String, u64>

struct Output:
    code: i32
    out: String
    err: String

fn run(program: str, args: [String], cwd: &Path?) -> Output:
    var cmd = Command::new(program)
    cmd.args(args)
    if let Some(d) = cwd:
        cmd.current_dir(d)
    r = cmd.output().expect("run the subprocess")
    Output {
        code: r.status.code().unwrap_or(-1),
        out: String::from_utf8_lossy(&r.stdout).to_string(),
        err: String::from_utf8_lossy(&r.stderr).to_string(),
    }

fn argv(items: [&str]) -> Vec<String>:
    items.iter().map(s => s.to_string()).collect()

fn rustc_version() -> String:
    run("rustc", argv(["--version"]), None).out.trim().to_string()

## Everything under `from`, except the build directory, copied to `to`.
fn copy_tree(from: &Path, to: &Path):
    fs::create_dir_all(to).expect("the destination directory")
    if let Ok(entries) = fs::read_dir(from):
        for entry in entries.flatten():
            name = entry.file_name().to_string_lossy().to_string()
            if name == "target":
                continue
            source = entry.path()
            dest = to.join(&name)
            if source.is_dir():
                copy_tree(&source, &dest)
            else:
                fs::copy(&source, &dest).expect("copy a file")

## Copy a crate, rename its `main`, and append the probe. Returns the reason it could not be done.
fn prepare(src_crate: &Path, dest: &Path) -> String?:
    fs::remove_dir_all(dest).ok()
    copy_tree(src_crate, dest)
    main_rs = dest.join("src").join("main.rs")
    text = fs::read_to_string(&main_rs).expect("the program source")
    pattern = Regex::new(r"\bfn main\s*\(").expect("the pattern")
    n = pattern.find_iter(&text).count()
    if n != 1:
        return Some(format("expected exactly one `fn main(`, found {n}"))
    renamed = pattern.replace(&text, "fn __prog_main(").to_string()
    fs::write(&main_rs, format("{renamed}{COUNTER}")).expect("write the prepared source")
    None

## The `name = "…"` of a manifest, which is what Cargo calls the binary.
fn package_name(manifest: &Path) -> String?:
    named = Regex::new(r#"(?m)^\s*name\s*=\s*"([^"]+)""#).expect("the pattern")
    text = fs::read_to_string(manifest).unwrap_or_default()
    named.captures(&text).map(c => c[1].to_string())

## Build in release and run; the error string says why it could not be measured.
fn measure(crate_dir: &Path) -> Result<Side, String>:
    build = run("cargo", argv(["build", "--release", "--quiet"]), Some(crate_dir))
    if build.code != 0:
        last = build.err.trim().lines().last().unwrap_or("?").to_string()
        return Err(format("build failed: {last}"))
    name = match package_name(&crate_dir.join("Cargo.toml")):
        Some(n): n
        None: return Err(String::from("no package name in the manifest"))
    exe = crate_dir.join("target").join("release").join(&name)
    if !exe.exists():
        return Err(format("no binary at {}", exe.display()))
    probe = Regex::new(r"__ALLOC_PROBE (\d+) (\d+) (\d+)").expect("the pattern")
    var runs: Vec<(u64, u64, u64)> = Vec::new()
    for _i in 0..RUNS:
        r = run(exe.to_string_lossy().as_ref(), Vec::new(), Some(crate_dir))
        if r.code != 0:
            tail: String = r.err.trim().chars().rev().take(200).collect::<String>().chars().rev().collect()
            return Err(format("run failed ({}): {}", r.code, tail))
        match probe.captures(&r.err):
            None:
                return Err(String::from("no probe line in stderr"))
            Some(c):
                runs.push((c[1].parse().unwrap_or(0), c[2].parse().unwrap_or(0), c[3].parse().unwrap_or(0)))
    first = runs[0]
    stable = runs.iter().all(r => *r == first)
    Ok(Side {
        allocations: first.0,
        bytes: first.1,
        peak: first.2,
        size: fs::metadata(&exe).map(m => m.len()).unwrap_or(0),
        stable,
        runs,
    })

fn measure_side(crate_dir: &Path, dest: &Path) -> Result<Side, String>:
    match prepare(crate_dir, dest):
        Some(why): Err(why)
        None: measure(dest)

## Python's `json.dump(ensure_ascii=True)`: every non-ASCII character as a `\uXXXX` escape, so the
## record this writes is byte-identical to the one the script it replaced wrote.
fn ascii_escaped(json: str) -> String:
    var out = String::new()
    for c in json.chars():
        if (c as u32) < 128:
            out.push(c)
        else:
            var buf = [0u16; 2]
            for unit in c.encode_utf16(&mut buf):
                out.push_str(&format("\\u{:04x}", unit))
    out

fn write_json(path: &Path, value: &impl Serialize):
    var buffer = Vec::new()
    formatter = serde_json::ser::PrettyFormatter::with_indent(b" ")
    var ser = serde_json::Serializer::with_formatter(&mut buffer, formatter)
    value.serialize(&mut ser).expect("serialise")
    text = String::from_utf8(buffer).expect("utf-8")
    fs::write(path, ascii_escaped(&text)).expect("write the record")

fn main():
    root = corpus_root()
    args: Vec<String> = std::env::args().skip(1).collect()
    update = args.iter().any(a => a == "--update-baseline")
    wanted: Vec<String> = args.iter().filter(a => !a.starts_with("--")).map(a => a.clone()).collect()
    uredo = root.join("../compiler/target/debug/uredo")
    work = root.join("target").join("perf")
    baseline_path = root.join("size_baseline.json")

    numbered = Regex::new(r"^\d\d_").expect("the pattern")
    var programs: Vec<String> = Vec::new()
    if let Ok(entries) = fs::read_dir(&root):
        for entry in entries.flatten():
            n = entry.file_name().to_string_lossy().to_string()
            if entry.path().is_dir() && numbered.is_match(&n):
                programs.push(n)
    programs.sort()
    if !wanted.is_empty():
        programs = programs.iter().filter(p => wanted.contains(p) || wanted.iter().any(w => p.starts_with(w))).map(p => p.clone()).collect()
    fs::create_dir_all(&work).expect("the work directory")

    version = rustc_version()
    baseline: Baseline = fs::read_to_string(&baseline_path).ok().and_then(t => serde_json::from_str(&t).ok()).unwrap_or_default()
    baseline_applies = baseline.rustc == version
    var results: Vec<Entry> = Vec::new()

    for p in programs:
        var entry = Entry { program: p.clone(), error: None, uredo: None, rust: None, stable: None,
            exceeds: None, pass: None, identical: None, baseline_size: None, over_baseline: None }
        pkg = root.join(&p)
        export = work.join(format("{p}_ure_export"))
        fs::remove_dir_all(&export).ok()
        e = run(uredo.to_string_lossy().as_ref(), Vec::from([String::from("package"), pkg.display().to_string(), String::from("--out"), export.display().to_string()]), None)
        if e.code != 0:
            entry.error = Some(format("package failed: {}", last_200(&e.err)))
        else:
            for (side, dir) in [("uredo", export.clone()), ("rust", pkg.join("idiomatic"))]:
                match measure_side(&dir, &work.join(format("{p}_{side}"))):
                    Err(why):
                        if entry.error.is_none():
                            entry.error = Some(format("{side}: {why}"))
                    Ok(v):
                        if side == "uredo":
                            entry.uredo = Some(v)
                        else:
                            entry.rust = Some(v)
        match (entry.error.clone(), entry.uredo.clone(), entry.rust.clone()):
            (None, Some(u), Some(r)):
                exceeds: Vec<String> = gated().iter().filter(m => measure_of(&u, m) > measure_of(&r, m)).map(m => m.to_string()).collect()
                stable = u.stable && r.stable
                base = baseline.size.get(p).copied()
                over = baseline_applies && base.map_or(false, b => u.size > b)
                passed = stable && exceeds.is_empty()
                identical = u.allocations == r.allocations && u.bytes == r.bytes && u.peak == r.peak
                verdict = if passed && !over:
                    String::from("pass")
                else if !stable:
                    String::from("unstable")
                else:
                    format("FAIL {}", if exceeds.is_empty(): String::from("over baseline") else: exceeds.join(","))
                print("{:<22} allocs {:5}/{:<5} peak {:7}/{:<7} size {:7}/{:<7} {}",
                    p, u.allocations, r.allocations, u.peak, r.peak, u.size, r.size, verdict)
                entry.stable = Some(stable)
                entry.exceeds = Some(exceeds)
                entry.pass = Some(passed)
                entry.identical = Some(identical)
                entry.baseline_size = base
                entry.over_baseline = Some(over)
            _:
                print("{:<22} {}", p, entry.error.clone().unwrap_or_default())
        results.push(entry)

    ok: Vec<&Entry> = results.iter().filter(e => e.pass == Some(true) && e.over_baseline != Some(true)).collect()
    broken: Vec<&Entry> = results.iter().filter(e => e.error.is_some()).collect()
    bad: Vec<&Entry> = results.iter().filter(e => e.error.is_none() && !(e.pass == Some(true) && e.over_baseline != Some(true))).collect()
    identical: Vec< && Entry> = ok.iter().filter(e => e.identical == Some(true)).collect()
    print("\n{}/{} pass ({} allocation-identical), {} failing or unstable, {} not measured",
        ok.len(), results.len(), identical.len(), bad.len(), broken.len())
    if !baseline_applies && !baseline.rustc.is_empty():
        print("size baseline is for {}, not {}: reported, not gated", baseline.rustc, version)

    if update:
        var sizes: BTreeMap<String, u64> = BTreeMap::new()
        if !wanted.is_empty():
            sizes = baseline.size.clone()
        for e in results:
            if let Some(u) = &e.uredo:
                sizes.insert(e.program.clone(), u.size)
        written = Baseline {
            note:
            String::from("release binary size of the generated side, per program; toolchain-specific, so it gates only on this rustc (§36)"),
            rustc: version.clone(),
            size: sizes,
        }
        write_json(&baseline_path, &written)
        print("size baseline written for {version}")

    failed = !bad.is_empty() || !broken.is_empty()
    if wanted.is_empty():
        write_report(&root, results, ok.len(), bad.len(), broken.len(), identical.len(), &version, baseline_applies)
        write_json(&root.join("perf.json"), &Report { rustc: version.clone(), programs: results })
    if failed:
        std::process::exit(1)

## The number, and the name after it, as the table's first two columns want them.
fn split_number(program: str) -> (String, String):
    match program.split_once('_'):
        Some((n, rest)): (n.to_string(), rest.to_string())
        None: (program.to_string(), String::new())

fn write_report(root: &Path, results: [Entry], ok: usize, bad: usize, broken: usize, identical: usize, version: str, baseline_applies: bool):
    var f: Vec<String> = Vec::new()
    f.push(String::from("# §36 allocation, memory and size fixtures — results (generated by `corpus/perf.py`)\n"))
    f.push(format("Four measures per program. §36 gates the first two against the twin — the generated Rust must not allocate more often or ask for more bytes — and gates binary size against a checked-in baseline. A counting global allocator is appended to both sides, each is built in release with the same settings and run {} times, and a program whose own counts move between runs is reported as unstable rather than compared.\n", RUNS))
    f.push(String::from("**Binary size is not compared against the twin, deliberately.** The two crates differ in name (`cNN_x` against `cNN_x_rs`), so every mangled symbol differs in length, and the build paths differ too. Rebuilding one twin under the Uredo crate's own name moved the gap from 328 bytes to 384 in the other direction, which is the size of one padding step: at this granularity the paired figure measures the build layout, not the lowering. The checked-in baseline (`size_baseline.json`, rewritten with `--update-baseline`) is what catches a regression in the generated code over time, on a matching toolchain.\n"))
    f.push(String::from("**Peak live bytes is reported, not gated.** One program differs: 13_ownership holds 2,006 bytes at its peak against the twin's 1,991, because `for (k, v) in self.headers` iterates by shared reference under D12 while the twin's loop consumes the map and frees as it goes. That is the language rule working as written, not a lowering cost; the allocation count and the total bytes are identical.\n"))
    f.push(format("**{} of {} programs pass**; failing or unstable {}; not measured {}. Of the passing ones, {} are *identical* to their twin in allocations, bytes and peak.\n", ok, results.len(), bad, broken, identical))
    f.push(format("Measured with `{}`; the size baseline {}.\n", version, if baseline_applies: "was recorded on this toolchain and gates here" else: "was recorded on another toolchain, so it only reports"))
    f.push(String::from("| # | program | allocations | bytes | peak live bytes | binary size | verdict |"))
    f.push(String::from("|---|---|---|---|---|---|---|"))
    for e in results:
        (num, rest) = split_number(&e.program)
        match (e.uredo.clone(), e.rust.clone()):
            (Some(u), Some(r)):
                var verdict = if e.pass == Some(true) && e.over_baseline != Some(true):
                    String::from("pass")
                else if e.stable != Some(true):
                    String::from("unstable")
                else:
                    String::from("**fail**")
                if e.pass == Some(true) && e.over_baseline != Some(true) && e.identical != Some(true):
                    verdict = String::from("pass (peak differs)")
                f.push(format("| {} | {} | {} / {} | {} / {} | {} / {} | {} / {} | {} |",
                    num, rest, u.allocations, r.allocations, u.bytes, r.bytes, u.peak, r.peak, u.size, r.size, verdict))
            _:
                f.push(format("| {} | {} | — | — | — | — | not measured: {} |", num, rest, e.error.clone().unwrap_or_default()))
    f.push(String::from("\nEach cell is uredo / rust; the size column's second figure is context, not a gate. Method: `uredo package` exports the Uredo side as a self-contained crate, the twin is copied as it is, each program's `main` is renamed so a wrapper can report the totals after it returns, and the probe is appended — never prepended, since a module's inner docs must stay first. Startup allocations made by the Rust runtime are included and are paid by both sides. `realloc` counts as one allocation, charges the growth, and moves the live total by the difference."))
    fs::write(root.join("PERF.md"), format("{}\n", f.join("\n"))).expect("write the report")

fn last_200(s: str) -> String:
    t = s.trim()
    if t.chars().count() <= 200:
        t.to_string()
    else:
        t.chars().skip(t.chars().count() - 200).collect::<String>()

fn measure_of(side: &Side, name: str) -> u64:
    match name:
        "allocations": side.allocations
        "bytes": side.bytes
        "peak": side.peak
        _: side.size

fn corpus_root() -> PathBuf:
    var here = std::env::current_dir().unwrap_or_else(_e => PathBuf::from("."))
    loop:
        if here.join("corpus").join("run.py").is_file():
            return here.join("corpus")
        match here.parent():
            Some(up):
                here = up.to_path_buf()
            None:
                return PathBuf::from("corpus")
