##! The state, and the only place this service allocates per request beyond the response body.
##!
##! `Arc<Store>` is cloned once per connection and shared across tasks; inside, one `RwLock` over
##! the map. Reads take the read half, so concurrent GETs do not serialise on each other.
##!
##! This module exists because `Arc` and `RwLock` had **zero uses** across all 62 files of real
##! Uredo before it (see `examples/restdemo/DESIGN.md` §2). It is the shape the ownership rules were
##! least tested against.

use std::collections::BTreeMap
use std::sync::RwLock
use std::sync::atomic::{AtomicU64, Ordering}

use crate::model::{Health, Item, ItemPatch, NewItem}
use crate::query::Query

pub struct Store:
    items: RwLock<BTreeMap<u64, Item>>
    next: AtomicU64

impl Store:
    pub fn new() -> Store:
        Store { items: RwLock::new(BTreeMap::new()), next: AtomicU64::new(1) }

    ## A snapshot of every item, in id order. `BTreeMap` rather than `HashMap` so the order is
    ## stable without a sort on every list.
    pub fn list(self) -> Vec<Item>:
        guard = self.items.read().unwrap()
        guard.values().cloned().collect()

    ## The same, filtered and paged. The query borrows the request's bytes and this borrows the
    ## query, so a filtered list allocates only the items it returns — the predicates compare
    ## against `&str` that was never copied.
    pub fn select(self, q: &Query) -> Vec<Item>:
        guard = self.items.read().unwrap()
        guard
            .values()
            .filter(i => q.done.is_none_or(d => i.done == d))
            .filter(i => q.label.is_none_or(l => i.labels.iter().any(have => have == l)))
            .filter(i => q.contains.is_none_or(c => i.name.contains(c)))
            .skip(q.offset)
            .take(q.limit)
            .cloned()
            .collect()

    pub fn get(self, id: u64) -> Item?:
        guard = self.items.read().unwrap()
        guard.get(&id).cloned()

    ## Names are unique, so a repeat is a 409 rather than a second row. This is the one place
    ## the store rejects rather than stores, and it is why `Error::Conflict` exists.
    pub fn create(self, new: take NewItem) -> Item throws crate::error::Error:
        var guard = self.items.write().unwrap()
        if guard.values().any(i => i.name == new.name):
            throw crate::error::Error::Conflict(format("an item named {:?} already exists", new.name))
        id = self.next.fetch_add(1, Ordering::Relaxed)
        item = Item::from_new(id, new)
        guard.insert(id, item.clone())
        item

    pub fn patch(self, id: u64, patch: take ItemPatch) -> Item?:
        var guard = self.items.write().unwrap()
        existing = guard.get_mut(&id)?
        existing.apply(patch)
        Some(existing.clone())

    pub fn delete(self, id: u64) -> bool:
        var guard = self.items.write().unwrap()
        guard.remove(&id).is_some()

    pub fn len(self) -> usize:
        self.items.read().unwrap().len()

    ## Health as a typed value rather than a hand-built string, so it goes through the same
    ## encoder as everything else.
    pub fn health(self) -> Health:
        Health { status: String::from("ok"), items: self.len() as u64 }
