##! Gate item 7 (§34, §36): two small kernels whose optimised IR must be identical to the
##! hand-written Rust twin in `../rust/src/lib.rs`. `keep.rs` forces codegen of both; it is
##! declared `pub` explicitly because automatic module declarations are private (§20.3).

pub mod keep

## Dot product over two borrowed slices (P2), bounds-checked indexing as in Rust.
pub fn dot(a: [f64], b: [f64]) -> f64:
    var acc = 0.0
    for i in 0..a.len().min(b.len()):
        acc += a[i] * b[i]
    acc

## Word count over the bytes of a borrowed string: a small state machine.
pub fn count_words(s: str) -> usize:
    var count = 0
    var in_word = false
    for b in s.bytes():
        if b == b' ' || b == b'\n' || b == b'\t':
            in_word = false
        else if !in_word:
            in_word = true
            count += 1
    count
