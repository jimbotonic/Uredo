##! Phase 0 gate package (§34): a mixed `.ure`/`.rs` library with a binary.
##! `route.rs` is a hand-written Rust module, declared automatically (§20.3).

pub mod route

use std::thread

## Gate item 1: calls into the generic Rust callee are verbatim (§10.3, D2). `n` is a scalar,
## so `route(n)` instantiates `T = u8` and `route(&n)` instantiates `T = &u8`; the program
## means what the source says, and `uredo explain` reports "verbatim" for both calls.
pub fn labels(n: u8) -> (&'static str, &'static str):
    (route::route(n), route::route(&n))

## Gate item 2: methods generated by derive macros on an Uredo struct, called from Uredo.
@derive(Debug, Clone, PartialEq, Eq, Hash, Default)
pub struct Job:
    pub id: u32
    pub payload: String

    pub fn new(id: u32, payload: str) -> Self:
        Self { id, payload: payload.to_string() }

## `clone()`, `==`, `Default::default()` and `{:?}` all come from the derives.
pub fn derive_roundtrip(job: Job) -> (bool, String, Job):
    twin = job.clone()
    (twin == *job, format("{job:?}"), Job::default())

## Gate item 3: a closure crossing an ownership-sensitive external API. `move` is written
## (§17); the closure body is one expression; `job` is consumed by the thread.
pub fn spawn_len(job: take Job) -> usize:
    handle = thread::spawn(move () => job.payload.len())
    handle.join().unwrap()

## Gate item 6: feature-dependent code. Each variant is an ordinary item under `@cfg`.
@cfg(feature = "fancy")
pub fn greeting() -> String:
    String::from("hello (fancy)")

@cfg(not(feature = "fancy"))
pub fn greeting() -> String:
    String::from("hello")
