##! 13. Ownership transfer: `take` parameters, consuming receivers, a builder, explicit clones.

@derive(Debug, Clone)
struct Job:
    id: u32
    payload: String

@derive(Debug, Default)
struct Queue:
    jobs: Vec<Job>

    fn enqueue(self: inout, job: take Job):
        self.jobs.push(job)

    fn drain(self: take) -> Vec<Job>:
        self.jobs

struct RequestBuilder:
    url: String
    headers: Vec<(String, String)>

    fn new(url: str) -> Self: RequestBuilder { url: url.to_string(), headers: Vec::new() }

    fn header(var self: take, key: str, value: str) -> Self:
        self.headers.push((key.to_string(), value.to_string()))
        self

    fn build(self: take) -> String:
        var out = format("GET {}", self.url)
        for (k, v) in self.headers:
            out.push_str(&format("\n{k}: {v}"))
        out

fn consume(text: take String) -> usize:
    text.len()

fn main():
    var queue = Queue::default()
    job = Job { id: 1, payload: String::from("data") }
    queue.enqueue(job.clone())
    queue.enqueue(job)
    jobs = queue.drain()
    print("{} jobs, first #{} {:?}", jobs.len(), jobs[0].id, jobs[0].payload)
    request = RequestBuilder::new("/index").header("Host", "example.org").header("Accept", "*/*").build()
    print("{request}")
    text = String::from("moved into consume")
    print("{}", consume(text))
