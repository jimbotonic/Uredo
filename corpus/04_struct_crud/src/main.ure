##! 4. Struct CRUD: a repository of users with create, read, update and delete methods.

@derive(Debug, Clone, PartialEq)
pub struct User:
    pub id: u32
    pub name: String
    pub active: bool

pub struct Repo:
    users: Vec<User>
    next_id: u32

    pub fn new() -> Self:
        Repo { users: Vec::new(), next_id: 1 }

    pub fn create(self: inout, name: str) -> u32:
        id = next_id
        self.users.push(User { id, name: name.to_string(), active: true })
        self.next_id += 1
        id

    pub fn get(self, id: u32) -> &User?:
        users.iter().find(u => u.id == id)

    pub fn rename(self: inout, id: u32, name: str) -> bool:
        match self.users.iter_mut().find(u => u.id == id):
            Some(user):
                user.name = name.to_string()
                true
            None: false

    pub fn deactivate(self: inout, id: u32):
        for user in inout self.users:
            if user.id == id:
                user.active = false

    pub fn delete(self: inout, id: u32) -> bool:
        before = users.len()
        self.users.retain(u => u.id != id)
        users.len() != before

    pub fn active_names(self) -> Vec<String>:
        users.iter().filter(u => u.active).map(u => u.name.clone()).collect()

fn main():
    var repo = Repo::new()
    ada = repo.create("Ada")
    bob = repo.create("Bob")
    _ = repo.create("Cy")
    print("{:?}", repo.get(ada))
    print("renamed: {}", repo.rename(bob, "Robert"))
    repo.deactivate(ada)
    print("deleted missing: {}", repo.delete(99))
    print("deleted cy: {}", repo.delete(3))
    print("active: {:?}", repo.active_names())
