##! 11. Generic functions and a generic struct: bounds, `where`, P8 by-value type parameters.

use std::fmt::Display

fn largest<T: PartialOrd + Copy>(items: [T]) -> T?:
    var best = *items.first()?
    for item in items:
        if *item > best:
            best = *item
    Some(best)

fn describe_all<T>(items: [T], label: impl Display) -> Vec<String>
where:
    T: Display:
    items.iter().map(i => format("{label}: {i}")).collect()

fn pair_up<A, B>(a: A, b: B) -> (A, B): (a, b)

@derive(Debug)
struct Stack<T>:
    items: Vec<T>

    fn new() -> Self: Stack { items: Vec::new() }
    fn push(self: inout, item: T): self.items.push(item)
    fn pop(self: inout) -> T?: self.items.pop()
    fn peek(self) -> &T?: items.last()
    fn len(self) -> usize: items.len()

fn main():
    print("{:?} {:?}", largest([3, 9, 2]), largest(Vec::<f64>::new()))
    for line in describe_all(["x", "y"], "item"):
        print("{line}")
    (n, s) = pair_up(1, String::from("one"))
    print("{n} {s}")
    var stack: Stack<String> = Stack::new()
    stack.push(String::from("a"))
    stack.push(String::from("b"))
    print("{:?} len {}", stack.peek(), stack.len())
    print("{:?} {:?}", stack.pop(), stack.pop())
    print("{:?}", stack.pop())
