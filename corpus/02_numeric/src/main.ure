##! 2. Numeric computation: integer and float arithmetic, loops, a sieve, statistics.

fn gcd(a: u64, b: u64) -> u64:
    var x = a
    var y = b
    while y != 0:
        t = y
        y = x % y
        x = t
    x

fn primes_below(limit: usize) -> Vec<usize>:
    var sieve = vec![true; limit]
    var primes = Vec::new()
    for n in 2..limit:
        if sieve[n]:
            primes.push(n)
            var m = n * n
            while m < limit:
                sieve[m] = false
                m += n
    primes

fn mean_and_variance(xs: [f64]) -> (f64, f64):
    n = xs.len() as f64
    mean = xs.iter().sum::<f64>() / n
    variance = xs.iter().map(x => (x - mean) *(x - mean)).sum::<f64>() / n
    (mean, variance)

fn main():
    print("gcd(1071, 462) = {}", gcd(1071, 462))
    primes = primes_below(50)
    print("{} primes below 50, last {}", primes.len(), primes[primes.len() - 1])
    (mean, variance) = mean_and_variance([2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0])
    print("mean {mean:.2} variance {variance:.2} sd {:.2}", variance.sqrt())
    total: u32 = (1..=100u32).filter(n => n % 3 == 0 || n % 5 == 0).sum()
    print("multiples of 3 or 5 below 101 sum to {total}")
